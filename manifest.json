{
  "schemaVersion": 1,
  "id": "io.github.kambiz.neon-clock",
  "name": "Neon Clock",
  "version": "0.4.0",
  "author": "Kambiz",
  "license": "MIT",
  "description": "A standalone neon digital clock with eight digit colors, three sizes, 12/24-hour time and optional seconds.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Neon Clock",
    "description": "Neon tube digits that roll when the time changes.",
    "category": "Time",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "use24Hour": true,
      "showSeconds": false,
      "digitColor": "yellow",
      "digitSize": "large"
    },
    "schema": [
      {
        "key": "use24Hour",
        "type": "boolean",
        "label": "24-hour clock",
        "defaultValue": true,
        "description": "Off shows 12-hour time with AM/PM."
      },
      {
        "key": "showSeconds",
        "type": "boolean",
        "label": "Show seconds",
        "defaultValue": false,
        "description": "Adds a seconds pair and rolls it every second."
      },
      {
        "key": "digitColor",
        "type": "enum",
        "label": "Digit color",
        "options": [
          "yellow",
          "green",
          "red",
          "purple",
          "lightblue",
          "orange",
          "white",
          "black"
        ],
        "defaultValue": "yellow",
        "description": "Color of the neon tube and its glow."
      },
      {
        "key": "digitSize",
        "type": "enum",
        "label": "Digit size",
        "options": [
          "small",
          "medium",
          "large"
        ],
        "defaultValue": "large",
        "description": "Size of the digits relative to the bar."
      }
    ]
  }
}
